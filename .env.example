MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=change_this_database_password
MARIADB_ROOT_PASSWORD=change_this_root_password

WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=1
WORDPRESS_PUBLIC_URL=http://localhost:8080
WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M
WP_ENVIRONMENT_TYPE=development

PHPMYADMIN_UPLOAD_LIMIT=256M

NODE_ENV=development
BFF_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177
FRONTEND_URL=http://localhost:5177
BFF_PUBLIC_URL=http://localhost:3000
GEO_ALLOWED_COUNTRIES=US,BR
GEO_DEVELOPMENT_COUNTRY=BR
GEO_IP_PROVIDER_URL=https://ipwho.is/{ip}
GEO_IP_TIMEOUT_MS=2500
GEO_CACHE_TTL_MS=43200000

# Inside Docker, use http://wordpress. If running BFF outside Docker, use http://localhost:8080.
WOOCOMMERCE_URL=http://wordpress
WOOCOMMERCE_CONSUMER_KEY=replace_with_woocommerce_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=replace_with_woocommerce_consumer_secret
WOOCOMMERCE_TIMEOUT_MS=8000

STRIPE_SECRET_KEY=sk_test_mocked_for_local_dev
STRIPE_WEBHOOK_SECRET=whsec_mocked_for_local_dev
STRIPE_SHIPPING_COUNTRIES=US,CA,GB,ES
STRIPE_SHIPPING_RATE_NAME=Standard shipping
STRIPE_SHIPPING_RATE_AMOUNT=999
STRIPE_FREE_SHIPPING_RATE_NAME=Free shipping
STRIPE_SHIPPING_MIN_DELIVERY_DAYS=3
STRIPE_SHIPPING_MAX_DELIVERY_DAYS=5
FREE_SHIPPING_VARIATION_IDS=29,30
STRIPE_SHIPPING_PROTECTION_NAME=Shipping protection
STRIPE_SHIPPING_PROTECTION_AMOUNT=350
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_TIMEOUT_MS=10000

WIIO_FULFILLMENT_ENABLED=false
WIIO_SYNC_MODE=woocommerce
WIIO_API_URL=
WIIO_API_KEY=
WIIO_AUTH_HEADER=
WIIO_AUTH_SCHEME=Bearer
WIIO_WEBHOOK_SECRET=replace_with_wiio_tracking_webhook_secret
WIIO_TIMEOUT_MS=10000
